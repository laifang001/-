        nav a {
            color:#fff;
            text-decoration:none;
            margin:0 16px;
            font-size:16px;
        }
        nav a:hover{
            color:#3498db;
        }
        .container{
            max-width:1100px;
            margin: 40px auto;
            padding:0 20px;
        }
        section{
            background:#fff;
            padding:30px;
            margin-bottom:30px;
            border-radius:10px;
            box-shadow: 0 2px 10px #00000015;
        }
        h2{
            color:#2c3e50;
            margin-bottom:18px;
            border-left:4px solid #3498db;
